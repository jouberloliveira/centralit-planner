DATABASE_URL="postgresql://planner:planner@localhost:5432/planner?schema=public"
PORT=3001
HOST=0.0.0.0
# Required. Must be ≥32 chars; never commit a real value. Generate via: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
# Required. Comma-separated allow-list of full origins (scheme + host + port).
# `*` is rejected because the API sends credentials (cookies/Authorization).
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL="info"
