{
  "$schema": "https://schemas.paperclip.ing/design-tokens/1.0",
  "meta": {
    "name": "Planner Design Tokens",
    "version": "0.1.0",
    "issue": "CEN-9",
    "consumers": ["CEN-12", "CEN-13"],
    "references": ["Microsoft Planner", "Trello", "Azure DevOps"],
    "a11y": {
      "minContrastNormalText": 4.5,
      "minContrastLargeText": 3.0,
      "focusRingTokens": ["color.border.focus", "shadow.focus"]
    }
  },
  "color": {
    "brand": {
      "50":  "#EEF4FF",
      "100": "#D9E5FF",
      "200": "#B4CCFF",
      "300": "#88AEFF",
      "400": "#5E8FFF",
      "500": "#3D6DFD",
      "600": "#2D55E0",
      "700": "#2342B3",
      "800": "#1B3286",
      "900": "#142563"
    },
    "neutral": {
      "0":   "#FFFFFF",
      "50":  "#F7F8FA",
      "100": "#EEF0F4",
      "200": "#DDE1E8",
      "300": "#C2C8D2",
      "400": "#9AA1AE",
      "500": "#6B7280",
      "600": "#4B5563",
      "700": "#374151",
      "800": "#1F2937",
      "900": "#0B1220"
    },
    "semantic": {
      "success": { "50": "#E8F8EF", "500": "#16A34A", "700": "#0F7A37" },
      "warning": { "50": "#FFF6E5", "500": "#F59E0B", "700": "#B5730A" },
      "danger":  { "50": "#FDECEC", "500": "#DC2626", "700": "#9B1C1C" },
      "info":    { "50": "#E6F4FB", "500": "#0EA5E9", "700": "#0369A1" }
    },
    "type": {
      "epic":    { "fg": "#FFFFFF", "bg": "#7C3AED", "border": "#5B21B6" },
      "feature": { "fg": "#FFFFFF", "bg": "#2563EB", "border": "#1E40AF" },
      "story":   { "fg": "#FFFFFF", "bg": "#059669", "border": "#065F46" },
      "task":    { "fg": "#1F2937", "bg": "#E5E7EB", "border": "#9CA3AF" }
    },
    "status": {
      "backlog":     { "fg": "#374151", "bg": "#EEF0F4" },
      "todo":        { "fg": "#1E40AF", "bg": "#DBEAFE" },
      "in_progress": { "fg": "#92400E", "bg": "#FEF3C7" },
      "in_review":   { "fg": "#5B21B6", "bg": "#EDE9FE" },
      "done":        { "fg": "#065F46", "bg": "#D1FAE5" },
      "cancelled":   { "fg": "#6B7280", "bg": "#F3F4F6" }
    },
    "priority": {
      "critical": "#DC2626",
      "high":     "#F59E0B",
      "medium":   "#2563EB",
      "low":      "#6B7280"
    },
    "surface": {
      "bg":           "#F7F8FA",
      "raised":       "#FFFFFF",
      "overlay":      "rgba(11,18,32,0.48)",
      "drawer":       "#FFFFFF",
      "column":       "#EEF0F4"
    },
    "text": {
      "primary":   "#0B1220",
      "secondary": "#4B5563",
      "tertiary":  "#6B7280",
      "onBrand":   "#FFFFFF",
      "disabled":  "#9AA1AE",
      "link":      "#2D55E0"
    },
    "border": {
      "default": "#DDE1E8",
      "subtle":  "#EEF0F4",
      "strong":  "#C2C8D2",
      "focus":   "#3D6DFD",
      "danger":  "#DC2626"
    },
    "dark": {
      "surface": { "bg": "#0B1220", "raised": "#111827", "column": "#1F2937", "drawer": "#111827" },
      "text":    { "primary": "#F7F8FA", "secondary": "#C2C8D2", "tertiary": "#9AA1AE" },
      "border":  { "default": "#374151", "subtle": "#1F2937", "strong": "#4B5563" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": {
      "xs":   { "size": "0.75rem",  "lineHeight": "1rem",     "weight": 500, "letterSpacing": "0.02em" },
      "sm":   { "size": "0.875rem", "lineHeight": "1.25rem",  "weight": 500, "letterSpacing": "0"       },
      "base": { "size": "1rem",     "lineHeight": "1.5rem",   "weight": 400, "letterSpacing": "0"       },
      "lg":   { "size": "1.125rem", "lineHeight": "1.75rem",  "weight": 500, "letterSpacing": "0"       },
      "xl":   { "size": "1.25rem",  "lineHeight": "1.75rem",  "weight": 600, "letterSpacing": "-0.01em" },
      "2xl":  { "size": "1.5rem",   "lineHeight": "2rem",     "weight": 600, "letterSpacing": "-0.01em" },
      "3xl":  { "size": "1.875rem", "lineHeight": "2.25rem",  "weight": 700, "letterSpacing": "-0.02em" },
      "4xl":  { "size": "2.25rem",  "lineHeight": "2.5rem",   "weight": 700, "letterSpacing": "-0.02em" }
    },
    "roles": {
      "displayLg":  "4xl",
      "displayMd":  "3xl",
      "h1":         "2xl",
      "h2":         "xl",
      "h3":         "lg",
      "bodyLg":     "base",
      "body":       "sm",
      "caption":    "xs",
      "code":       "sm"
    }
  },
  "spacing": {
    "0":  "0",
    "1":  "0.25rem",
    "2":  "0.5rem",
    "3":  "0.75rem",
    "4":  "1rem",
    "5":  "1.25rem",
    "6":  "1.5rem",
    "8":  "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "24": "6rem"
  },
  "radius": {
    "none":  "0",
    "xs":    "2px",
    "sm":    "4px",
    "md":    "6px",
    "lg":    "8px",
    "xl":    "12px",
    "2xl":   "16px",
    "pill":  "999px"
  },
  "shadow": {
    "none":  "none",
    "xs":    "0 1px 1px rgba(11,18,32,0.04)",
    "sm":    "0 1px 2px rgba(11,18,32,0.06), 0 1px 1px rgba(11,18,32,0.04)",
    "md":    "0 4px 8px rgba(11,18,32,0.08), 0 2px 4px rgba(11,18,32,0.04)",
    "lg":    "0 12px 24px rgba(11,18,32,0.10), 0 4px 8px rgba(11,18,32,0.06)",
    "xl":    "0 24px 48px rgba(11,18,32,0.14), 0 8px 16px rgba(11,18,32,0.08)",
    "focus": "0 0 0 3px rgba(61,109,253,0.40)",
    "drag":  "0 16px 32px rgba(11,18,32,0.18), 0 6px 12px rgba(11,18,32,0.10)"
  },
  "motion": {
    "duration": { "instant": "0ms", "fast": "120ms", "base": "200ms", "slow": "320ms" },
    "easing":   { "standard": "cubic-bezier(0.2, 0, 0, 1)", "emphasized": "cubic-bezier(0.3, 0, 0, 1)", "exit": "cubic-bezier(0.4, 0, 1, 1)" }
  },
  "zIndex": {
    "base":     0,
    "raised":   10,
    "sticky":   20,
    "drawer":   40,
    "modal":    50,
    "popover":  60,
    "toast":    70,
    "tooltip":  80
  },
  "breakpoints": {
    "sm":  "640px",
    "md":  "768px",
    "lg":  "1024px",
    "xl":  "1280px",
    "2xl": "1536px"
  },
  "components": {
    "card": {
      "padding": "spacing.4",
      "radius":  "radius.md",
      "shadow":  "shadow.sm",
      "shadowHover": "shadow.md",
      "shadowDrag":  "shadow.drag",
      "borderLeftWidth": "3px"
    },
    "column": {
      "width":   "320px",
      "gap":     "spacing.3",
      "padding": "spacing.3",
      "radius":  "radius.lg",
      "bg":      "color.surface.column"
    },
    "drawer": {
      "width":   "min(560px, 100vw)",
      "padding": "spacing.6",
      "shadow":  "shadow.xl",
      "radius":  "radius.lg"
    },
    "button": {
      "heightSm": "28px",
      "heightMd": "36px",
      "heightLg": "44px",
      "paddingX": "spacing.4",
      "radius":   "radius.md",
      "focus":    "shadow.focus"
    },
    "input": {
      "height":   "36px",
      "paddingX": "spacing.3",
      "radius":   "radius.md",
      "borderColor": "color.border.default",
      "borderColorFocus": "color.border.focus",
      "focus":    "shadow.focus"
    },
    "chip": {
      "height":   "20px",
      "paddingX": "spacing.2",
      "radius":   "radius.pill",
      "fontSize": "xs"
    }
  }
}
